[Unit]
Description=Host health guardian
Documentation=https://github.com/developerinlondon/host-guardian
# It reads PID 1's mount table: ProtectHome/ProtectSystem give this unit its
# own namespace with the protected submounts removed, so its own mountinfo
# would report mounted filesystems as absent. That makes ProtectProc= and
# PrivatePIDs= load-bearing by their absence — either one hides PID 1 and every
# configured mount reports missing at once.
After=local-fs.target
Wants=local-fs.target

[Service]
Type=notify
ExecStart=/usr/bin/host-guardian --config /etc/host-guardian/config.json
Restart=always
RestartSec=5s
# Restart= only fires when the process exits. WatchdogSec catches the case that
# actually matters for a guardian: alive, is-active says active, guarding
# nothing. The daemon pings at half this interval.
WatchdogSec=60s

# It stops other units, so it needs the systemd bus and root. Everything else
# is closed off.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/host-guardian /var/log/host-guardian
PrivateTmp=no
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_KILL CAP_DAC_READ_SEARCH

# The guardian must survive the pressure it exists to respond to.
OOMPolicy=continue
OOMScoreAdjust=-900
MemoryLow=32M
Nice=-5

[Install]
WantedBy=multi-user.target
