#!/bin/sh
set -e

case "$1" in
configure)
    # The textfile directory is read by node-exporter, which runs unprivileged.
    mkdir -p /var/lib/hostguard/textfile /var/log/hostguard/incidents
    chmod 0755 /var/lib/hostguard /var/lib/hostguard/textfile
    chmod 0750 /var/log/hostguard /var/log/hostguard/incidents

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        # Only on first install ($2 is the previously configured version, empty
        # when there is none). Enabling on every upgrade would silently undo a
        # deliberate `systemctl disable` and start a daemon that stops services.
        if [ -z "$2" ]; then
            # Enabled but not started: the shipped config has no shed units and
            # no mount expectations, so starting it here would do nothing.
            # An operator edits /etc/hostguard/config.json and then starts it.
            systemctl enable hostguard.service || true
        fi
        if systemctl is-active --quiet hostguard.service; then
            systemctl restart hostguard.service || true
        fi
    fi
    ;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
*)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

exit 0
